---
// AI Assistant Preview Component
---

<div
  class="bg-gradient-to-br from-gray-200 via-gray-200 to-primary/80 p-px rounded-lg mt-4 opacity-65"
>
  <div class="bg-white rounded-lg p-4 min-h-40 flex flex-col">
    <!-- Header -->
    <div class="flex items-center gap-1.5 mb-3">
      <svg
        class="w-3.5 h-3.5 text-primary flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
        ></path>
      </svg>
      <span class="text-xs font-semibold text-slate-900">AI Assistant</span>
    </div>

    <!-- Conversation -->
    <div class="flex-1 space-y-2">
      <!-- User prompt -->
      <div class="flex justify-end">
        <div
          class="bg-primary/10 text-slate-900 text-[11px] leading-snug rounded-md px-2 py-1"
        >
          Write a launch email
        </div>
      </div>

      <!-- Answer -->
      <p class="text-[11px] text-gray-700 leading-snug">
        Drafted <span class="text-slate-900 font-medium"
          >“Simpler pricing, same power”</span
        > — subject line, preview text and 3 blocks.
      </p>
    </div>

    <!-- Composer -->
    <div class="mt-auto pt-3">
      <div
        class="flex items-center gap-2 rounded-md border border-gray-200 px-2 py-1.5"
      >
        <span class="flex-1 text-[11px] text-gray-400">Ask anything…</span>
        <span
          class="w-4 h-4 rounded bg-primary flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-2.5 h-2.5 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>
