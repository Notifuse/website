---
import CustomForm from "./CustomForm.astro"

const { lang = "en" } = Astro.props
const isFr = lang === "fr"

const t = isFr ? {
  title: "Licence Custom",
  intro: "Dites-nous votre organisation, le nombre de workspaces et l'hébergement envisagé — réponse sous deux jours ouvrés.",
  close: "Fermer",
} : {
  title: "Custom licence",
  intro: "Tell us your organisation, your workspace count and how you plan to host — we reply within two business days.",
  close: "Close",
}
---

<div
  id="custom-backdrop"
  class="fixed inset-0 z-[99] bg-black/40 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<div
  id="custom-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 transition-opacity duration-300 opacity-0 pointer-events-none overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label={t.title}
>
  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl shadow-black/10 my-8">
    <div class="flex items-start justify-between px-6 pt-6 pb-2">
      <h2 class="text-xl font-bold text-slate-900">{t.title}</h2>
      <button
        type="button"
        data-custom-close
        aria-label={t.close}
        class="text-gray-400 hover:text-gray-700 transition-colors text-2xl leading-none px-1"
      >&times;</button>
    </div>
    <p class="px-6 text-sm text-gray-600 mb-4">{t.intro}</p>
    <div class="px-6 pb-6">
      <CustomForm lang={lang} />
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__nf_custom_init) return
    window.__nf_custom_init = true

    var modal = document.getElementById("custom-modal")
    var backdrop = document.getElementById("custom-backdrop")
    if (!modal || !backdrop) return

    function open() {
      modal.classList.remove("opacity-0", "pointer-events-none")
      backdrop.classList.remove("opacity-0", "pointer-events-none")
      document.body.classList.add("overflow-hidden")
      var first = modal.querySelector("input, select, textarea")
      if (first) first.focus()
    }
    function close() {
      modal.classList.add("opacity-0", "pointer-events-none")
      backdrop.classList.add("opacity-0", "pointer-events-none")
      document.body.classList.remove("overflow-hidden")
    }

    document.querySelectorAll("[data-custom-open]").forEach(function (el) {
      el.addEventListener("click", function (e) {
        e.preventDefault()
        open()
      })
    })
    modal.querySelectorAll("[data-custom-close]").forEach(function (el) {
      el.addEventListener("click", close)
    })
    backdrop.addEventListener("click", close)
    modal.addEventListener("click", function (e) {
      if (e.target === modal) close()
    })
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close()
    })
  })()
</script>
