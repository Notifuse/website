---
import sparkpostLogo from "../assets/integrations/sparkpost.png"
import postmarkLogo from "../assets/integrations/postmark.png"
import mailjetLogo from "../assets/integrations/mailjet.png"
import mailgunLogo from "../assets/integrations/mailgun.png"
import amazonSesLogo from "../assets/integrations/amazonses.png"
import anthropicLogo from "../assets/integrations/anthropic.png"
import openaiLogo from "../assets/integrations/openai.png"
import googleGeminiLogo from "../assets/integrations/gemini.svg"
import firecrawlLogo from "../assets/integrations/firecrawl.svg"
import supabaseLogo from "../assets/integrations/supabase.png"
import zapierLogo from "../assets/integrations/zapier.svg"

const logos = [
  { src: sparkpostLogo.src, alt: "SparkPost" },
  { src: postmarkLogo.src, alt: "Postmark" },
  { src: mailjetLogo.src, alt: "Mailjet" },
  { src: mailgunLogo.src, alt: "Mailgun" },
  { src: amazonSesLogo.src, alt: "Amazon SES" },
  { src: anthropicLogo.src, alt: "Anthropic" },
  { src: openaiLogo.src, alt: "OpenAI" },
  { src: googleGeminiLogo.src, alt: "Google Gemini" },
  { src: firecrawlLogo.src, alt: "Firecrawl" },
  { src: supabaseLogo.src, alt: "Supabase" },
  { src: zapierLogo.src, alt: "Zapier" },
]
---

<div class="mt-20">
  <p class="text-center text-gray-600 mb-8 text-lg">
    Works with industry-leading providers and tools
  </p>
  <div class="relative overflow-hidden">
    <!-- Left fade gradient -->
    <div
      class="absolute left-0 top-0 w-16 h-full bg-linear-to-r from-white-98 to-transparent z-10 pointer-events-none"
    >
    </div>
    <!-- Right fade gradient -->
    <div
      class="absolute right-0 top-0 w-16 h-full bg-linear-to-l from-white-98 to-transparent z-10 pointer-events-none"
    >
    </div>
    <div class="flex animate-scroll">
      {
        [0, 1, 2].map((setIndex) => (
          <div
            class={`flex items-center space-x-4 md:space-x-8 min-w-max ${setIndex > 0 ? "ml-4 md:ml-8" : ""}`}
          >
            {logos.map((logo) => (
              <div class="p-4 w-32 h-16 flex items-center justify-center">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class="max-h-8 max-w-full object-contain filter grayscale hover:grayscale-0 transition-all duration-300"
                />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>
