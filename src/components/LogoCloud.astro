---
const { lang = "en" } = Astro.props

const logoModules = import.meta.glob(
  "../assets/logocloud/*.{svg,png,webp,jpg}",
  {
    eager: true,
    query: "?url",
    import: "default",
  },
) as Record<string, string>

const logoSrc = (slug: string) =>
  Object.entries(logoModules).find(([path]) =>
    path.includes(`/logocloud/${slug}.`),
  )?.[1]

// h = display height (px) scaled so every logo occupies the same
// surface: its mark bounding box = 2.99 cm2 at 96 dpi (median of all
// logos at h-10/40px, internal file padding excluded).
const brands = lang === "fr" ? [
        { "name": "Accor", "slug": "accor", "h": 29.4 },
        { "name": "Leroy Merlin", "slug": "leroy-merlin", "h": 50.7 },
        { "name": "Fnac Darty", "slug": "fnac-darty", "h": 28.7 },
        { "name": "Decathlon", "slug": "decathlon", "h": 35.5 },
        { "name": "Krys", "slug": "krys", "h": 80.9 },
        { "name": "Audika", "slug": "audika", "h": 37.1 },
        { "name": "Orpi", "slug": "orpi", "h": 47.5 },
        { "name": "Bouygues", "slug": "bouygues", "h": 46.7 },
        { "name": "Castorama", "slug": "castorama", "h": 66.8 },
        { "name": "Renault", "slug": "renault", "h": 75 },
        { "name": "Speedy", "slug": "speedy", "h": 62 },
        { "name": "Fitness Park", "slug": "fitness-park", "h": 29.5 },
        { "name": "Groupama", "slug": "groupama", "h": 40.4 },
        { "name": "Ramsay Santé", "slug": "ramsay-sante", "h": 62.8 },
        { "name": "Shiva", "slug": "shiva", "h": 57.3 }
      ] :[
        { "name": "Marriott International", "slug": "marriott-international", "h": 50.4 },
        { "name": "Hilton", "slug": "hilton", "h": 39.8 },
        { "name": "IKEA", "slug": "ikea", "h": 41.3 },
        { "name": "Best Buy", "slug": "best-buy", "h": 50 },
        { "name": "RE/MAX", "slug": "re-max", "h": 28 },
        { "name": "Midas", "slug": "midas", "h": 52 },
        { "name": "Ford", "slug": "ford", "h": 40 },
        { "name": "Avis Budget Group", "slug": "avis-budget-group", "h": 31 },
        { "name": "Planet Fitness", "slug": "planet-fitness", "h": 65.1 },
        { "name": "Kumon", "slug": "kumon", "h": 31.6 },
        { "name": "State Farm", "slug": "state-farm", "h": 24.3 },
        { "name": "Edward Jones", "slug": "edward-jones", "h": 27.8 },
        { "name": "Aspen Dental", "slug": "aspen-dental", "h": 27.7 },
        { "name": "LensCrafters", "slug": "lenscrafters", "h": 36.8 },
        { "name": "Mattress Firm", "slug": "mattress-firm", "h": 33.8 }
      ]

// Globe layout: 1 logo at the centre, 5 on a middle ring, 9 on the
// outer ring. Outer logos are scaled down (perspective) like a tag
// cloud on a sphere. Base size is brand.h / 2, scaled up 30%.
const placed = brands.map((brand, i) => {
  const ring = i === 0 ? 0 : i <= 5 ? 1 : 2
  const count = ring === 0 ? 1 : ring === 1 ? 5 : 9
  const idx = ring === 0 ? 0 : ring === 1 ? i - 1 : i - 6
  const angle =
    ring === 0
      ? 0
      : ((-90 + (idx * 360) / count + (ring === 2 ? 20 : 0)) * Math.PI) / 180
  const radius = ring === 0 ? 0 : ring === 1 ? 15 : 26
  const depth = [1, 0.9, 0.78][ring]
  const top = 50 + radius * Math.sin(angle)
  return {
    ...brand,
    ring,
    left: 50 + radius * Math.cos(angle),
    // Remap the cluster (centres span 24-76% of a square) to fill the
    // cropped container height, so no empty margin sits above it.
    top: ((top - 23) / 56) * 100,
    displayH: ((brand.h / 2) * 1.3 * depth) / 5.2,
  }
})
---

<div
  class="relative mx-auto aspect-[26/15] w-full max-w-[520px]"
  style="container-type: inline-size"
  role="img"
  aria-label={brands.map((brand) => brand.name).join(", ")}
>
  {placed.map((brand) => (
    <img
      src={logoSrc(brand.slug)}
      alt={brand.name}
      loading="lazy"
      style={`left: ${brand.left}%; top: ${brand.top}%; height: ${brand.displayH}cqw; transform: translate(-50%, -50%)`}
      class="absolute w-auto max-w-[28%] object-contain"
    />
  ))}
</div>
