---
import logoMedium from "../assets/logo/logo-medium.png"

const isFr = Astro.url.pathname.startsWith('/fr')

const t = isFr ? {
  features: "Fonctionnalités",
  featuresHref: "/fr/#features",
  solutions: "Solutions",
  solutionItems: [
    { label: "Réseaux multi-entités", href: "/fr/#segment-networks" },
    { label: "Secteur public", href: "/fr/#segment-public" },
    { label: "Industries régulées", href: "/fr/#segment-regulated" },
    { label: "Sécurité & conformité", href: "/fr/#security" },
  ],
  compare: "Comparer",
  compareHref: "/fr/compare",
  pricing: "Tarifs",
  pricingHref: "/fr/tarifs",
  docs: "Docs",
  login: "Connexion",
  mobileCta: "Voir les licences",
  cta: "Commencer",
  ctaHref: "/fr/tarifs",
} : {
  features: "Features",
  featuresHref: "/#features",
  solutions: "Solutions",
  solutionItems: [
    { label: "Multi-entity networks", href: "/#segment-networks" },
    { label: "Public sector", href: "/#segment-public" },
    { label: "Regulated industries", href: "/#segment-regulated" },
    { label: "Security & compliance", href: "/#security" },
  ],
  compare: "Compare",
  compareHref: "/compare",
  pricing: "Pricing",
  pricingHref: "/pricing",
  docs: "Docs",
  login: "Log in",
  mobileCta: "See licences",
  cta: "Get Started",
  ctaHref: "/pricing",
}
---

<!-- Navigation -->
<nav
  class="border-b border-gray-200 sticky top-0 z-50 backdrop-blur-sm bg-white-98/95"
>
  <div class="max-w-5xl mx-auto px-4 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center gap-8">
        <a href={isFr ? "/fr/" : "/"}>
          <img src={logoMedium.src} alt="Notifuse" class="h-8" />
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-6 text-sm">
        <a
          href={t.featuresHref}
          class="text-gray-600 hover:text-gray-900 transition-colors"
          >{t.features}</a
        >
        <div class="relative group">
          <button
            type="button"
            class="text-gray-600 hover:text-gray-900 transition-colors inline-flex items-center gap-1"
            aria-haspopup="true"
          >
            {t.solutions}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-gray-200 rounded-md shadow-lg py-2 w-60">
              {t.solutionItems.map((item) => (
                <a href={item.href} class="block px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors">{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        <a
          href={t.compareHref}
          class="text-gray-600 hover:text-gray-900 transition-colors">{t.compare}</a
        >
        <a
          href={t.pricingHref}
          class="text-gray-600 hover:text-gray-900 transition-colors">{t.pricing}</a
        >
        <a
          href="https://docs.notifuse.com"
          class="text-gray-600 hover:text-gray-900 transition-colors">{t.docs}</a
        >
        </div>
      </div>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center space-x-6">
        <div class="pt-[7px]">
          <a
            class="github-button"
            href="https://github.com/notifuse/notifuse"
            data-color-scheme="no-preference: light; light: light; dark: light;"
            data-size="large"
            data-show-count="true"
            aria-label="Star notifuse/notifuse on GitHub"
          >
            Star
          </a>
        </div>
        <a
          href="https://cloud.notifuse.com"
          class="text-sm text-gray-600 hover:text-gray-900 transition-colors"
          >{t.login}</a
        >
        <a
          href={t.ctaHref}
          class="bg-primary text-white px-4 py-1 rounded-md hover:bg-primary/80 transition-colors"
          >{t.cta}</a
        >
      </div>

      <!-- Mobile Actions -->
      <div class="md:hidden flex items-center gap-6">
        <div class="pt-[7px]">
          <a
            class="github-button"
            href="https://github.com/notifuse/notifuse"
            data-color-scheme="no-preference: light; light: light; dark: light;"
            data-size="large"
            data-show-count="true"
            aria-label="Star notifuse/notifuse on GitHub"
          >
            Star
          </a>
        </div>
        <button
          type="button"
          id="mobile-menu-button"
          class="text-gray-600 hover:text-gray-900 transition-colors flex items-center"
          aria-label={isFr ? "Ouvrir le menu" : "Open menu"}
        >
          <svg
            id="menu-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-gray-200 bg-white"
    >
      <div class="px-4 py-4 space-y-4">
        <a
          href={t.featuresHref}
          class="block text-gray-600 hover:text-gray-900 transition-colors"
          >{t.features}</a
        >
        <div>
          <p class="text-gray-400 text-xs font-semibold uppercase tracking-wide mb-2">{t.solutions}</p>
          <div class="space-y-3 pl-3">
            {t.solutionItems.map((item) => (
              <a href={item.href} class="block text-gray-600 hover:text-gray-900 transition-colors">{item.label}</a>
            ))}
          </div>
        </div>
        <a
          href={t.compareHref}
          class="block text-gray-600 hover:text-gray-900 transition-colors"
          >{t.compare}</a
        >
        <a
          href={t.pricingHref}
          class="block text-gray-600 hover:text-gray-900 transition-colors"
          >{t.pricing}</a
        >
        <a
          href="https://docs.notifuse.com"
          class="block text-gray-600 hover:text-gray-900 transition-colors"
          >{t.docs}</a
        >
        <div class="pt-4 border-t border-gray-200 space-y-4">
          <a
            href={t.ctaHref}
            class="block bg-primary text-white px-4 py-2 rounded-md hover:bg-primary/80 transition-colors text-center"
            >{t.mobileCta}</a
          >
        </div>
      </div>
    </div>
  </div>
</nav>

<script async defer src="https://buttons.github.io/buttons.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const mobileMenuButton = document.getElementById("mobile-menu-button")
    const mobileMenu = document.getElementById("mobile-menu")
    const menuIcon = document.getElementById("menu-icon")
    const closeIcon = document.getElementById("close-icon")

    if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
      mobileMenuButton.addEventListener("click", function () {
        const isMenuOpen = !mobileMenu.classList.contains("hidden")

        if (isMenuOpen) {
          mobileMenu.classList.add("hidden")
          menuIcon.classList.remove("hidden")
          closeIcon.classList.add("hidden")
          mobileMenuButton.setAttribute("aria-label", "Open menu")
        } else {
          mobileMenu.classList.remove("hidden")
          menuIcon.classList.add("hidden")
          closeIcon.classList.remove("hidden")
          mobileMenuButton.setAttribute("aria-label", "Close menu")
        }
      })

      const mobileMenuLinks = mobileMenu.querySelectorAll("a")
      mobileMenuLinks.forEach((link) => {
        link.addEventListener("click", function () {
          mobileMenu.classList.add("hidden")
          menuIcon.classList.remove("hidden")
          closeIcon.classList.add("hidden")
          mobileMenuButton.setAttribute("aria-label", "Open menu")
        })
      })
    }
  })
</script>
