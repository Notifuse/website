---
import worldMap from "../data/world-map.json"

// Share of sessions per country, driving the choropleth shading.
// Country names match Natural Earth's naming in src/data/world-map.json.
const shares: Record<string, number> = {
  "United States of America": 0.95,
  France: 0.8,
  "United Kingdom": 0.68,
  Germany: 0.6,
  India: 0.5,
  Canada: 0.46,
  Brazil: 0.42,
  Netherlands: 0.4,
  Australia: 0.4,
  Spain: 0.38,
  Italy: 0.35,
  Japan: 0.3,
  Belgium: 0.3,
  Switzerland: 0.28,
  Mexico: 0.26,
  Poland: 0.25,
  Sweden: 0.25,
  Portugal: 0.22,
  Ireland: 0.22,
  Austria: 0.2,
  Denmark: 0.2,
  Norway: 0.2,
  "South Africa": 0.2,
  Argentina: 0.19,
  "South Korea": 0.18,
  Romania: 0.16,
  Czechia: 0.16,
  Turkey: 0.15,
  Indonesia: 0.14,
  Nigeria: 0.13,
  China: 0.12,
  Russia: 0.1,
}
const BASE = 0.07
---

<div
  class="bg-gradient-to-br from-gray-200 via-gray-200 to-primary/80 p-px rounded-lg mt-4 opacity-65"
>
  <div class="bg-white rounded-lg p-4 min-h-40 flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-slate-900">Last 30 days</span>
      <span class="flex items-center gap-1.5 text-[10px] text-gray-500">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
        18 live now
      </span>
    </div>

    <!-- Key Metrics -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 text-center mb-3">
      <div>
        <div class="text-sm font-bold text-primary whitespace-nowrap">
          12,480
        </div>
        <div class="text-[10px] text-gray-500">Sessions</div>
      </div>
      <div>
        <div class="text-sm font-bold text-slate-900 whitespace-nowrap">
          1m 24s
        </div>
        <div class="text-[10px] text-gray-500">TimeScore</div>
      </div>
      <div>
        <div class="text-sm font-bold text-slate-900 whitespace-nowrap">38%</div>
        <div class="text-[10px] text-gray-500">Bounce</div>
      </div>
      <div>
        <div class="text-sm font-bold text-green-600 whitespace-nowrap">342</div>
        <div class="text-[10px] text-gray-500">Goals</div>
      </div>
    </div>

    <!-- Traffic Chart with Broadcast Annotation -->
    <div class="relative">
      <div
        class="absolute top-0 left-[60%] -translate-x-full pr-1 text-[9px] font-medium text-primary whitespace-nowrap"
      >
        Newsletter #42
      </div>
      <svg
        class="w-full h-16"
        viewBox="0 0 200 56"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="waSparkFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#7763F1" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="#7763F1" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path
          d="M0,40 L14,37 L28,42 L42,36 L56,39 L70,34 L84,38 L98,35 L112,38 L120,37 L128,15 L142,9 L156,18 L170,25 L184,20 L200,23 L200,56 L0,56 Z"
          fill="url(#waSparkFill)"></path>
        <polyline
          points="0,40 14,37 28,42 42,36 56,39 70,34 84,38 98,35 112,38 120,37 128,15 142,9 156,18 170,25 184,20 200,23"
          fill="none"
          stroke="#7763F1"
          stroke-width="1.5"
          stroke-linejoin="round"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"></polyline>
        <line
          x1="120"
          y1="0"
          x2="120"
          y2="56"
          stroke="#7763F1"
          stroke-width="1"
          stroke-dasharray="3 3"
          vector-effect="non-scaling-stroke"></line>
      </svg>
    </div>

    <!-- Sessions by Country -->
    <div class="mt-6 pt-6 border-t border-gray-100">
      <svg class="w-full" viewBox={worldMap.viewBox} aria-hidden="true">
        {
          worldMap.countries.map((c) => (
            <path d={c.d} fill="#7763F1" fill-opacity={shares[c.n] ?? BASE} />
          ))
        }
      </svg>
    </div>
  </div>
</div>
