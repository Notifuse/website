---
import "../../styles/global.css"
import Navigation from "../../components/Navigation.astro"
import Footer from "../../components/Footer.astro"
import GtagHead from "../../components/GtagHead.astro"
import NotifuseAnalytics from "../../components/NotifuseAnalytics.astro"
import { licensedCapabilities } from "../../data/licensing"

// Les licences auto-hébergées ouvrent cette page : c'est l'offre. Le Cloud suit comme
// alternative pour les organisations qui ne peuvent pas exécuter Notifuse elles-mêmes —
// présent, mais volontairement pas une carte à égalité.
const capabilityCount = licensedCapabilities.fr.length
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tarifs — Licences auto-hébergées & Cloud - Notifuse</title>
    <meta
      name="description"
      content="Deux façons d'exécuter Notifuse : un Cloud managé à partir de 16 $/mois, ou l'auto-hébergement sur votre infrastructure, sans frais par email, par contact ni par siège."
    />
    <link rel="canonical" href="https://www.notifuse.com/fr/tarifs" />
    <meta name="robots" content="index, follow" />
    <GtagHead />
    <NotifuseAnalytics />
  </head>

  <body class="bg-white-98 text-slate-900">
    <div class="container relative border-r border-l border-gray-200">
      <Navigation />

      <main>
        <section class="pt-28 pb-8 px-4 lg:px-8">
          <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Deux façons d'exécuter Notifuse</h1>
            <p class="text-xl text-gray-600">
              Auto-hébergez-le sur votre infrastructure avec une licence, ou laissez-nous
              l'exécuter pour vous en Europe.
            </p>
          </div>
        </section>

        <section class="pb-20 px-4 lg:px-8">
          <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          <div class="relative overflow-hidden border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col">
            <div class="absolute -top-8 -right-8 pointer-events-none" aria-hidden="true"><svg class="w-40 h-40 text-primary opacity-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg></div><h2 class="text-2xl font-bold mb-2">Licences auto-hébergées</h2>
            <p class="text-gray-600 mb-10">Vous l'exécutez, sur votre propre infrastructure.</p>
            <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Vos serveurs, votre base, vos données</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Emails, contacts, membres d'équipe et automatisations sans limite</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Trois workspaces gratuits, et {capabilityCount} capacités débloquées par une clé de licence</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Aucun compte, aucun appel sortant, rien ne nous est remonté</span></li>
            </ul>
            <div class="flex flex-wrap items-center gap-4 mt-auto">
              <a href="/fr/tarifs/auto-heberge" class="bg-primary text-white px-6 py-2.5 rounded-md font-semibold hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']">Voir les licences</a>
              <p class="text-gray-600 text-sm">Gratuit · ou dès 290 $/an</p>
            </div>
          </div>
          <div class="relative overflow-hidden border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col">
            <div class="absolute -top-8 -right-8 pointer-events-none" aria-hidden="true"><svg class="w-40 h-40 text-primary opacity-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.8 19a4.3 4.3 0 0 1-.6-8.55A6 6 0 0 1 17.9 8.7 4.6 4.6 0 0 1 17.2 19Z"/><path d="m9.5 14.5 2 2 3.5-3.5"/></svg></div><h2 class="text-2xl font-bold mb-2">Notifuse Cloud</h2>
            <p class="text-gray-600 mb-10">Nous l'exécutons. Vous vous connectez.</p>
            <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Un serveur PostgreSQL dédié, avec une base séparée par workspace</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Sauvegardes quotidiennes avec restauration à un instant donné</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Hébergé en Europe, conforme RGPD</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Toutes les capacités incluses, sur tous les plans — rien à maintenir</span></li>
            </ul>
            <div class="flex flex-wrap items-center gap-4 mt-auto">
              <a href="/fr/tarifs/cloud" class="bg-primary text-white px-6 py-2.5 rounded-md font-semibold hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']">Voir les plans Cloud</a>
              <p class="text-gray-600 text-sm">Dès 16 $/mois</p>
            </div>
          </div>
          </div>
          <p class="max-w-4xl mx-auto text-sm text-gray-500 text-center mt-8">
            Vous hésitez ? L'auto-hébergement s'essaie gratuitement et il n'y a rien à
            résilier — et vous pouvez passer de l'un à l'autre dans les deux sens, parce que
            l'export de données est complet et que le logiciel est le même.
          </p>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
