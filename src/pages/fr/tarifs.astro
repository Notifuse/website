---
import "../../styles/global.css"
import Navigation from "../../components/Navigation.astro"
import Footer from "../../components/Footer.astro"
import GtagHead from "../../components/GtagHead.astro"
import NotifuseAnalytics from "../../components/NotifuseAnalytics.astro"
import { selfHostTiers } from "../../data/licensing"

// The two ways to run Notifuse answer different questions, and a visitor who lands straight
// on monthly Cloud tiers has no way to know the other exists. For most of the people who find
// this project, self-hosting is the reason they came — so it gets equal weight here, and
// neither card is styled as the default.
const cheapestLicence = Math.min(...selfHostTiers.map((tier) => tier.annualUsd))
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tarifs - Notifuse</title>
    <meta
      name="description"
      content="Deux façons d'exécuter Notifuse : un Cloud managé à partir de 16 $/mois, ou l'auto-hébergement sur votre infrastructure, sans frais par email, par contact ni par siège."
    />
    <link rel="canonical" href="https://notifuse.com/fr/tarifs" />
    <meta name="robots" content="index, follow" />
    <GtagHead />
    <NotifuseAnalytics />
  </head>

  <body class="bg-white-98 text-slate-900">
    <div class="container relative border-r border-l border-gray-200">
      <Navigation />

      <main>
        <section class="pt-28 pb-8 px-4 lg:px-8">
          <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Deux façons d'exécuter Notifuse</h1>
            <p class="text-xl text-gray-600">
              Les deux envoient sans limite via votre propre fournisseur. Aucune ne facture
              par email, par contact ni par siège.
            </p>
          </div>
        </section>

        <section class="pb-16 px-4 lg:px-8">
          <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Cloud -->
            <div
              class="relative border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col"
            >
              <h2 class="text-2xl font-bold mb-2">Notifuse Cloud</h2>
              <p class="text-gray-600 mb-6">Nous l'exécutons. Vous vous connectez.</p>

              <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Un serveur PostgreSQL rien qu'à vous, dédié à votre déploiement — avec
                    une base séparée par workspace à l'intérieur</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Sauvegardes quotidiennes avec restauration à un instant donné</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Hébergé en Europe, conforme RGPD</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Toutes les capacités incluses, sur tous les plans</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Rien à maintenir, patcher ni surveiller</span>
                </li>
              </ul>

              <div class="border-t border-gray-100 pt-5">
                <p class="text-sm text-gray-500 mb-1">Facturé au mois ou à l'année</p>
                <p class="text-3xl font-bold mb-4">
                  Dès 16 $<span class="text-lg font-normal text-gray-500">/mois</span>
                </p>
                <a
                  href="/fr/tarifs/cloud"
                  class="block w-full text-center py-2.5 px-4 rounded-md font-semibold bg-primary text-white hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']"
                >
                  Voir les plans Cloud
                </a>
              </div>
            </div>

            <!-- Self-hosted -->
            <div
              class="relative border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col"
            >
              <h2 class="text-2xl font-bold mb-2">Auto-hébergé</h2>
              <p class="text-gray-600 mb-6">Vous l'exécutez, sur votre propre infrastructure.</p>

              <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Vos serveurs, votre base, vos données</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Emails, contacts, membres d'équipe et automatisations sans limite</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Trois workspaces, et toutes les capacités sauf cinq</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Aucun compte, aucun appel sortant, rien ne nous est remonté</span>
                </li>
                <li class="flex gap-2.5">
                  <span class="text-primary shrink-0">✓</span>
                  <span>Une clé de licence débloque les cinq, si vous en avez besoin</span>
                </li>
              </ul>

              <div class="border-t border-gray-100 pt-5">
                <p class="text-sm text-gray-500 mb-1">Gratuit, ou une licence annuelle</p>
                <p class="text-3xl font-bold mb-4">
                  Gratuit<span class="text-lg font-normal text-gray-500">
                    &nbsp;· ou dès {cheapestLicence} $/an</span
                  >
                </p>
                <a
                  href="/fr/tarifs/auto-heberge"
                  class="block w-full text-center py-2.5 px-4 rounded-md font-semibold bg-primary text-white hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']"
                >
                  Voir les licences
                </a>
              </div>
            </div>
          </div>

          <p class="max-w-4xl mx-auto text-sm text-gray-500 text-center mt-8">
            Vous hésitez ? L'auto-hébergement s'essaie gratuitement et il n'y a rien à
            résilier — et vous pouvez passer de l'un à l'autre dans les deux sens, parce que
            l'export de données est complet et que le logiciel est le même.
          </p>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
