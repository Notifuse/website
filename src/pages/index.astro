---
import "../styles/global.css"
import emailBuilderImage from "../assets/screenshots/email_editor.png"
import emailBuilderZoomImage from "../assets/screenshots/email_builder_zoom.png"
import IntegrationMarquee from "../components/IntegrationMarquee.astro"
import Navigation from "../components/Navigation.astro"
import GtagHead from "../components/GtagHead.astro"
import Footer from "../components/Footer.astro"
import FileManagerPreview from "../components/FileManagerPreview.astro"
import ContactProfilePreview from "../components/ContactProfilePreview.astro"
import AnalyticsPreview from "../components/AnalyticsPreview.astro"
import ABTestingPreview from "../components/ABTestingPreview.astro"
import TransactionalAPIPreview from "../components/TransactionalAPIPreview.astro"
import NotificationCenterPreview from "../components/NotificationCenterPreview.astro"
import SegmentationEnginePreview from "../components/SegmentationEnginePreview.astro"
import PermissionsPreview from "../components/PermissionsPreview.astro"
import WorkspacesPreview from "../components/WorkspacesPreview.astro"
import AutomationsPreview from "../components/AutomationsPreview.astro"
import AIPreview from "../components/AIPreview.astro"
import WebAnalyticsPreview from "../components/WebAnalyticsPreview.astro"
import NotifuseAnalytics from "../components/NotifuseAnalytics.astro"
import SecurityPreview from "../components/SecurityPreview.astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Notifuse — Email marketing on your infrastructure, under your control</title>
    <meta
      name="description"
      content="Self-hosted email platform for organisations that need control: deploy on your infrastructure, give each entity its own isolated workspace, govern access with SSO and audit logs. Send unlimited email to unlimited contacts."
    />

    <!-- SEO Meta Tags -->
    <link rel="canonical" href="https://notifuse.com/" />
    <meta name="theme-color" content="#7763F1" />
    <meta name="author" content="Notifuse" />
    <meta
      name="keywords"
      content="open source email platform, newsletter software, mailchimp alternative, self-hosted email, transactional email, MJML editor, email marketing, resend alternative"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://notifuse.com/" />
    <meta
      property="og:title"
      content="Notifuse — Email marketing on your infrastructure, under your control"
    />
    <meta
      property="og:description"
      content="Self-hosted email platform for organisations that need control: your infrastructure, isolated entities, SSO and audit logs. No per-email, per-contact or per-seat fee."
    />
    <meta property="og:image" content="https://notifuse.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Notifuse" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Notifuse — Email marketing on your infrastructure, under your control"
    />
    <meta
      name="twitter:description"
      content="Self-hosted email platform for organisations that need control: your infrastructure, isolated entities, SSO and audit logs. No per-email, per-contact or per-seat fee."
    />
    <meta name="twitter:image" content="https://notifuse.com/og-image.png" />
    <meta name="twitter:site" content="@notifuse" />
    <meta name="twitter:creator" content="@notifuse" />

    <!-- Additional Links -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <GtagHead />

    <script
      defer
      data-domain="notifuse.com"
      src="https://plausible.notifuse.com/js/script.js"></script>

    <!-- Staminads Analytics -->
    <link rel="dns-prefetch" href="https://prod.staminads.com" />
    <link rel="preconnect" href="https://prod.staminads.com" />
    <script is:inline>
    window.StaminadsConfig = {
      workspace_id: 'notifuse',
      endpoint: 'https://prod.staminads.com'
    };
    </script>
    <script async src="https://prod.staminads.com/sdk/staminads_6.1.0.min.js"></script>

    <!-- Notifuse Web Analytics -->
    <NotifuseAnalytics />
  </head>
  <body class="bg-white-98">
    <div class="container relative border-r border-l border-gray-200">
      <!-- Navigation -->
      <Navigation />

      <!-- Hero Section -->
      <section>
        <div class="px-4 lg:px-8 py-20">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Content -->
            <div class="text-center lg:text-left">
              <h1 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-6">
                Email marketing on <span class="italic text-primary"
                  >your infrastructure</span
                >, under your control.
              </h1>
              <p class="text-lg text-black mb-10 max-w-3xl lg:max-w-none">
                Deploy Notifuse on your own servers — or a European cloud you
                trust. Give each entity its own isolated workspace, govern access
                with SSO and audit logs, and send unlimited email to unlimited contacts.
              </p>
              <div
                class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start"
              >
                <a
                  href="https://demo.notifuse.com/console/signin?email=demo@notifuse.com"
                  class="order-2 sm:order-1 border border-gray-200 text-gray-700 bg-white sm:border-transparent sm:bg-primary sm:text-white px-4 py-2 rounded-md text-base font-semibold hover:bg-white sm:hover:bg-primary/80 transition-colors"
                >
                  See the live interface
                </a>
                <a
                  href="/pricing"
                  class="order-1 sm:order-2 bg-primary text-white sm:bg-transparent sm:border sm:border-gray-200 sm:text-gray-700 px-4 py-2 rounded-md text-base font-semibold hover:bg-primary/80 sm:hover:bg-white transition-colors"
                >
                  See licences
                </a>
              </div>
              <p class="text-sm text-gray-500 mt-5">
                <a href="/pricing/cloud" class="text-primary hover:underline">Or start with managed Cloud — EU-hosted, from $16/month</a>.
              </p>
            </div>

            <!-- App Preview -->
            <div
              class="relative max-w-md mx-auto lg:max-w-md lg:ml-auto lg:mr-0"
            >
              <div class="relative">
                <img
                  src={emailBuilderImage.src}
                  alt="Notifuse Dashboard Preview"
                  class="w-full rounded-xl shadow-xl shadow-primary/25 border border-gray-200"
                />
              </div>
            </div>
          </div>

          <!-- Integration Logos - Streaming -->
          <IntegrationMarquee />
        </div>
      </section>

      <!-- Trust figures: dated, sourced — verified 24 October 2026 -->
      <section class="border-t border-gray-200">
        <div class="grid grid-cols-2 md:grid-cols-4 md:divide-x divide-gray-200">
          <a href="https://github.com/notifuse/notifuse/releases" target="_blank" rel="noopener noreferrer" class="px-4 py-8 text-center hover:bg-white transition-colors">
            <p class="text-3xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-violet-400">95</p>
            <p class="text-sm text-gray-500 mt-1">releases in the last 12 months</p>
          </a>
          <a href="https://codecov.io/gh/Notifuse/notifuse" target="_blank" rel="noopener noreferrer" class="px-4 py-8 text-center hover:bg-white transition-colors">
            <p class="text-3xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-violet-400">&gt;90%</p>
            <p class="text-sm text-gray-500 mt-1">test coverage</p>
          </a>
          <a href="https://hub.docker.com/r/notifuse/notifuse" target="_blank" rel="noopener noreferrer" class="px-4 py-8 text-center hover:bg-white transition-colors">
            <p class="text-3xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-violet-400">10,000/mo</p>
            <p class="text-sm text-gray-500 mt-1">Docker image pulls</p>
          </a>
          <a href="https://github.com/notifuse/notifuse" target="_blank" rel="noopener noreferrer" class="px-4 py-8 text-center hover:bg-white transition-colors">
            <p class="text-2xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-violet-400">Open-source</p>
            <p class="text-sm text-gray-500 mt-1">code your security team can read and audit</p>
          </a>
        </div>
      </section>

      <!-- Segments -->
      <section class="border-t border-gray-200" id="segments">
        <div class="px-4 lg:px-8 py-16">
          <h2 class="text-2xl font-bold text-slate-900 text-center mb-10">
            For organisations that want to stay in control
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            <div id="segment-networks" class="border border-gray-200 rounded-lg p-6 bg-white scroll-mt-24">
              <h3 class="font-semibold text-slate-900 mb-2">Multi-entity networks</h3>
              <p class="text-sm text-gray-600">
                Franchises, groups and networks: headquarters sets the frame — templates,
                translations, permissions — while each entity keeps its own isolated
                workspace, domain and sending reputation.
              </p>
            </div>
            <div id="segment-public" class="border border-gray-200 rounded-lg p-6 bg-white scroll-mt-24">
              <h3 class="font-semibold text-slate-900 mb-2">Public sector</h3>
              <p class="text-sm text-gray-600">
                Deployed on your own infrastructure, with auditable code and no data
                leaving your perimeter. Custom licences are quoted per deployment, with
                purchase-order purchasing.
              </p>
            </div>
            <div id="segment-regulated" class="border border-gray-200 rounded-lg p-6 bg-white scroll-mt-24">
              <h3 class="font-semibold text-slate-900 mb-2">Regulated industries</h3>
              <p class="text-sm text-gray-600">
                SSO, granular permissions, scoped API keys and audit logs, running on
                infrastructure your organisation already qualifies — including health,
                on your own or your certified host's infrastructure.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Security & governance -->
      <section class="border-t border-gray-200" id="security">
        <div class="px-4 lg:px-8 py-16">
          <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-4">Security is a process, not a feature list</h2>
            <p class="text-gray-600 mb-6">
              Vulnerabilities are reported privately, acknowledged within three business
              days, and assessed within ten. Fixes ship in the latest release with a public
              advisory naming the version that corrects them — and staying current is part
              of the model, with about four releases a month. The licence key itself is
              verified offline: nothing about your installation ever leaves it.
            </p>
            <a href="https://github.com/notifuse/notifuse/blob/main/SECURITY.md" class="text-primary font-semibold hover:underline" target="_blank" rel="noopener noreferrer">Read our security policy →</a>
            </div>
            <SecurityPreview lang="en" />
          </div>
        </div>
      </section>

      <!-- Deployment -->
      <section class="border-t border-gray-200" id="deploy">
        <div class="px-4 lg:px-8 py-16">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-2xl font-bold text-slate-900 mb-4">Deploy it yourself, free</h2>
            <p class="text-gray-600 mb-6">
              No licence fee to start: install Notifuse on a server with PostgreSQL and an
              email provider, and run it in production with three workspaces. You pay for
              your infrastructure and your sending — nothing per email, per contact or per
              seat. A licence key unlocks more workspaces, permissions, SSO and audit logs
              when your organisation needs them.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="https://docs.notifuse.com/self-hosting/installation" class="bg-primary text-white px-4 py-2 rounded-md font-semibold hover:bg-primary/80 transition-colors">Install for free</a>
              <a href="/pricing/self-hosted" class="border border-gray-200 text-gray-700 px-4 py-2 rounded-md font-semibold hover:bg-white transition-colors">Compare licences</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Bento Grid -->
      <section class="border-t border-gray-200" id="features">
        <div class="py-20">
          <div class="px-4 lg:px-8 text-center mb-16">
            <h2 class="text-3xl font-bold text-slate-900 mb-4">
              Everything you need to succeed
            </h2>
            <p class="text-xl text-gray-600 mx-auto">
              Powerful features designed to help you create, send, and track
              your newsletters with ease.
            </p>
          </div>

          <!-- Bento Grid -->
          <div
            class="grid grid-cols-1 md:grid-cols-3 border-t border-gray-200 overflow-hidden"
          >
            <!-- Row 1: 2 Big Blocks -->
            <!-- Visual Email Builder -->
            <div
              class="md:col-span-2 p-8 border-r border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-6">
                <h3 class="text-lg font-bold text-slate-900">
                  Visual Email Builder
                </h3>
              </div>
              <div class="flex flex-col md:flex-row md:items-start gap-6">
                <div class="flex-1">
                  <p class="text-gray-600 text-sm mb-4">
                    Create stunning emails with our intuitive drag-and-drop
                    editor. Build responsive layouts with <span
                      class="text-primary font-semibold">MJML</span
                    > components and real-time preview.
                  </p>
                  <p class="text-gray-600 text-sm mb-6">
                    Personalize emails with <span
                      class="text-primary font-semibold">Liquid</span
                    > templating variables like <span
                      class="px-1.5 py-0.5 bg-orange-100 rounded font-mono text-xs"
                      >{`{{ contact.first_name }}`}</span
                    > and custom fields for dynamic content.
                  </p>
                </div>
                <div
                  class="bg-linear-to-br from-gray-200 via-gray-200 to-primary/80 p-px rounded-xl w-full md:max-w-72 md:flex-shrink-0"
                >
                  <div class="rounded-xl overflow-hidden bg-white">
                    <img
                      src={emailBuilderZoomImage.src}
                      alt="Email Builder Interface"
                      class="w-full h-auto opacity-65"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- S3 File Manager -->
            <div
              class="md:col-span-1 p-8 border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  S3 File Manager
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Integrated file management with <span
                  class="text-primary font-semibold">S3</span
                > compatible storage for images, attachments, and <span
                  class="text-primary font-semibold">CDN</span
                > delivery.
              </p>
              <FileManagerPreview />
            </div>

            <!-- Row 2: 3 Small Blocks -->
            <!-- Contact Profiles & Activity Timeline -->
            <div
              class="md:col-span-1 md:row-span-2 p-8 border-r border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  Contact Profiles & Timeline
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Rich contact profiles with
                <span class="text-primary font-semibold">custom fields</span>
                and complete activity history including messages,
                <span class="text-primary font-semibold">web sessions</span>
                and page views, profile changes, webhook events, and
                subscription list changes.
              </p>
              <ContactProfilePreview />
            </div>

            <!-- Transactional API & MJML -->
            <div
              class="md:col-span-2 p-8 border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  Transactional API
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Powerful <span class="text-primary font-semibold">REST API</span> for transactional emails with
                <span class="text-primary font-semibold">responsive templates</span> for perfect rendering across all devices.
              </p>
              <TransactionalAPIPreview />
            </div>

            <!-- Row 3: Opens & Click Tracking -->
            <!-- Opens & Click Tracking -->
            <div
              class="md:col-span-1 p-8 border-r border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  Opens & Click Tracking
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Real-time analytics with detailed
                <span class="text-primary font-semibold">open rates</span>,
                <span class="text-primary font-semibold">click tracking</span>, and engagement metrics for campaign optimization.
              </p>
              <AnalyticsPreview />
            </div>

            <!-- Notification Center -->
            <div
              class="md:col-span-1 p-8 border-r border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  Notification Center
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                <span class="text-primary font-semibold">Self-service portal</span> for contacts to manage subscriptions, preferences, and
                communication settings.
              </p>
              <NotificationCenterPreview />
            </div>

            <!-- A/B Testing -->
            <div
              class="md:col-span-1 p-8 border-b border-r border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  A/B Testing
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Optimize your newsletters with built-in
                <span class="text-primary font-semibold">A/B testing</span>
                for subject lines, content, and send times.
              </p>
              <ABTestingPreview />
            </div>

            <!-- Row 4: Segmentation Engine -->
            <!-- Real-time Segmentation -->
            <div
              class="md:col-span-1 p-8 border-b border-r border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  Real-time Segmentation
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Segment contacts by property, activity, and subscription. Build
                <span class="text-primary font-semibold">dynamic rules</span>
                with <span class="text-primary font-semibold">relative dates</span> for targeted campaigns.
              </p>
              <SegmentationEnginePreview />
            </div>

            <!-- Row 5: Permissions + Workspaces + Automations -->
            <!-- User Permissions -->
            <div
              class="md:col-span-1 p-8 border-b border-r border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  User Permissions
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                Granular <span class="text-primary font-semibold">workspace-level access control</span> with multiple roles.
                Perfect for team collaboration and security.
              </p>
              <p class="text-xs text-gray-400 mb-6">
                Every Cloud plan. Self-hosted: editing a restricted set needs a
                <a href="/pricing/self-hosted#features" class="hover:text-primary underline">licence key</a>.
              </p>
              <PermissionsPreview />
            </div>

            <!-- Workspaces -->
            <div
              class="md:col-span-1 p-8 border-b border-r border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">Workspaces</h3>
              </div>
              <p class="text-gray-600 text-sm mb-6">
                <span class="text-primary font-semibold">Multi-tenant</span>
                architecture with <span class="text-primary font-semibold">custom domains</span>. Each workspace has isolated data,
                contacts, and campaigns. Perfect for agencies.
              </p>
              <p class="text-xs text-gray-400 mb-6">
                Every Cloud plan. Self-hosted: three included, more with a
                <a href="/pricing/self-hosted#features" class="hover:text-primary underline">licence key</a>.
              </p>
              <WorkspacesPreview />
            </div>

            <!-- Automations -->
            <div
              class="md:col-span-2 p-8 border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Left Column: Title and Description -->
                <div class="flex flex-col justify-center md:order-1">
                  <div class="mb-4">
                    <h3 class="text-lg font-semibold text-slate-900">
                      Automations
                    </h3>
                  </div>
                  <p class="text-gray-600 text-sm mb-3">
                    <span class="text-primary font-semibold">Event-driven
                    workflows</span> built on contact timeline. Create
                    automated sequences based on subscriber behavior and
                    actions.
                  </p>
                  <p class="text-gray-600 text-sm mb-3">
                    Trigger emails, wait periods, conditions, and A/B tests in
                    multi-step flows. Perfect for welcome series, onboarding,
                    and re-engagement campaigns.
                  </p>
                  <p class="text-gray-600 text-sm">
                    Design complex journeys with
                    <span class="text-primary font-semibold">visual workflow
                    builder</span> and automatic execution — and automatically
                    stop the sequence the moment a contact replies, so you never
                    email someone who already responded.
                  </p>
                </div>

                <!-- Right Column: Illustration -->
                <div class="md:order-2">
                  <AutomationsPreview />
                </div>
              </div>
            </div>

            <!-- Row 6: AI + Web Analytics -->
            <!-- AI Assistant -->
            <div
              class="md:col-span-1 p-8 border-b border-r border-gray-200 hover:bg-white transition-colors"
            >
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-slate-900">
                  AI Assistant
                </h3>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                One assistant across Notifuse: write emails and subject lines in
                the editor, draft blog posts with their SEO metadata, and
                ask your <span class="text-primary font-semibold"
                  >Web Analytics</span
                > which campaigns actually worked.
              </p>
              <p class="text-gray-600 text-sm mb-6">
                Bring your own key — <span class="text-primary font-semibold"
                  >Anthropic</span
                >, <span class="text-primary font-semibold">OpenAI</span> or <span
                  class="text-primary font-semibold">Gemini</span
                >. Add <span class="text-primary font-semibold">Firecrawl</span> and
                it can research the web before it writes.
              </p>
              <AIPreview />
            </div>

            <!-- Web Analytics -->
            <div
              class="md:col-span-2 p-8 border-b border-gray-200 hover:bg-white transition-colors"
            >
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Left Column: Title and Description -->
                <div class="flex flex-col md:order-1">
                  <div class="mb-4">
                    <h3 class="text-lg font-semibold text-slate-900">
                      Web Analytics
                    </h3>
                  </div>
                  <p class="text-gray-600 text-sm mb-3">
                    Cookieless by design: no cookie, no consent banner, so you
                    measure <span class="text-primary font-semibold"
                      >100% of your traffic</span
                    > — not the slice that opts in.
                  </p>
                  <p class="text-gray-600 text-sm mb-3">
                    Split sources, group pages and define your own <span
                      class="text-primary font-semibold">channels</span
                    >, then rank them by <span class="text-primary font-semibold"
                      >TimeScore</span
                    >, the active time visitors really spend. Every broadcast
                    annotates itself on the chart, so you see what each campaign
                    brought in.
                  </p>
                  <p class="text-gray-600 text-sm mb-4">
                    Record goals with a value and read revenue back by channel,
                    ready for your <span class="text-primary font-semibold"
                      >segments</span
                    > and <span class="text-primary font-semibold"
                      >automations</span
                    >.
                  </p>
                </div>

                <!-- Right Column: Illustration -->
                <div class="md:order-2 flex flex-col justify-center">
                  <WebAnalyticsPreview />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Support Section -->
      <section class="border-t border-gray-200">
        <div class="px-4 lg:px-8 py-20">
          <div class="text-center max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-slate-900 mb-4">
              Customer support is always here to help you
            </h2>
            <p class="text-xl text-gray-600 mb-12">
              Whether you self-host or use Notifuse Cloud, we've got you
              covered.
            </p>
            <div
              class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-2xl mx-auto"
            >
              <div class="text-center">
                <h3 class="font-semibold text-slate-900 mb-2">
                  Notifuse Cloud
                </h3>
                <p class="text-gray-600 text-sm mb-4">
                  Priority email support on all paid plans.
                </p>
                <a
                  href="/pricing"
                  class="inline-block bg-primary text-white px-6 py-2.5 rounded-md font-semibold hover:bg-primary/90 transition-colors"
                >
                  View pricing
                </a>
              </div>
              <div class="text-center">
                <h3 class="font-semibold text-slate-900 mb-2">Self-hosted</h3>
                <p class="text-gray-600 text-sm mb-4">
                  Paid licences include private email support, Monday to Friday —
                  first reply within two business days, one when production is
                  blocked. Free tier: community support on GitHub.
                </p>
                <a
                  href="https://github.com/notifuse/notifuse/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block border border-gray-300 text-slate-900 px-6 py-2.5 rounded-md font-semibold hover:bg-gray-50 transition-colors"
                >
                  Open an issue
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Newsletter Subscribe Section -->
      <section class="bg-gray-900 text-white border-t border-gray-200">
        <div class="px-4 lg:px-8 py-20 text-center">
          <h2 class="text-2xl font-bold mb-4">
            Stay updated with <span class="italic text-primary">Notifuse</span>
          </h2>
          <p class="text-lg text-gray-300 mb-8 max-w-3xl mx-auto">
            Get the latest updates, feature announcements, and tips for building
            better newsletters. Join our community of developers and marketers.
          </p>
          <div class="max-w-md mx-auto">
            <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3">
              <input
                id="email-input"
                type="email"
                placeholder="Enter your email address"
                class="flex-1 px-3 py-2 rounded-md bg-gray-800 border border-gray-700 text-white placeholder-gray-400 focus:outline-hidden focus:ring-2 focus:ring-primary focus:border-transparent"
                required
              />
              <button
                id="subscribe-btn"
                type="submit"
                class="bg-primary text-white px-4 py-2 rounded-md text-base font-semibold hover:bg-primary/80 transition-colors whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Subscribe
              </button>
            </form>
            <div id="form-message" class="mt-3 text-sm"></div>
            <p class="text-sm text-gray-400 mt-3">
              No spam, unsubscribe at any time.
            </p>
          </div>
        </div>
      </section>
      <!-- Footer -->
      <Footer />
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById(
          "newsletter-form"
        ) as HTMLFormElement
        const emailInput = document.getElementById(
          "email-input"
        ) as HTMLInputElement
        const submitBtn = document.getElementById(
          "subscribe-btn"
        ) as HTMLButtonElement
        const messageDiv = document.getElementById(
          "form-message"
        ) as HTMLDivElement

        function showMessage(message: string, isError: boolean = false): void {
          if (messageDiv) {
            messageDiv.textContent = message
            messageDiv.className = `mt-3 text-sm ${isError ? "text-red-400" : "text-green-400"}`
          }
        }

        function setLoading(loading: boolean): void {
          if (submitBtn) {
            submitBtn.disabled = loading
            submitBtn.textContent = loading ? "Subscribing..." : "Subscribe"
          }
        }

        if (form && emailInput && submitBtn && messageDiv) {
          form.addEventListener("submit", async function (e) {
            e.preventDefault()

            const email = emailInput.value.trim()
            if (!email) {
              showMessage("Please enter a valid email address.", true)
              return
            }

            setLoading(true)
            messageDiv.textContent = ""

            try {
              const response = await fetch(
                "https://v3.notifuse.com/subscribe",
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({
                    workspace_id: "notifuse",
                    contact: {
                      email: email,
                    },
                    list_ids: ["newsletter"],
                  }),
                }
              )

              if (response.ok) {
                const data = await response.json()
                if (data.success) {
                  showMessage(
                    "Successfully subscribed! Check your email for confirmation."
                  )
                  emailInput.value = ""
                } else {
                  showMessage("Subscription failed. Please try again.", true)
                }
              } else {
                const errorData = await response.json().catch(() => ({}))
                const errorMessage =
                  errorData.message || "Subscription failed. Please try again."
                showMessage(errorMessage, true)
              }
            } catch (error) {
              console.error("Subscription error:", error)
              showMessage(
                "Network error. Please check your connection and try again.",
                true
              )
            } finally {
              setLoading(false)
            }
          })
        }
      })
    </script>
  </body>
</html>
