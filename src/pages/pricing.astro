---
import "../styles/global.css"
import Navigation from "../components/Navigation.astro"
import Footer from "../components/Footer.astro"
import GtagHead from "../components/GtagHead.astro"
import NotifuseAnalytics from "../components/NotifuseAnalytics.astro"
import { licensedCapabilities } from "../data/licensing"

// Self-hosted licences lead this page: they are the offer. Cloud follows as the
// alternative for organisations that cannot run Notifuse themselves — present,
// but deliberately not an equal-weight card.
const capabilityCount = licensedCapabilities.en.length
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Pricing — Self-hosted licences & Cloud - Notifuse</title>
    <meta
      name="description"
      content="Two ways to run Notifuse: a managed Cloud from $16/month, or self-hosted on your own infrastructure with no per-email, per-contact or per-seat fee."
    />
    <link rel="canonical" href="https://notifuse.com/pricing" />
    <meta name="robots" content="index, follow" />
    <GtagHead />
    <NotifuseAnalytics />
  </head>

  <body class="bg-white-98 text-slate-900">
    <div class="container relative border-r border-l border-gray-200">
      <Navigation />

      <main>
        <section class="pt-28 pb-8 px-4 lg:px-8">
          <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Two ways to run Notifuse</h1>
            <p class="text-xl text-gray-600">
              Self-host it on your infrastructure with a licence, or let us run it for you
              in the EU.
            </p>
          </div>
        </section>

        <section class="pb-20 px-4 lg:px-8">
          <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          <div class="relative overflow-hidden border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col">
            <div class="absolute -top-8 -right-8 pointer-events-none" aria-hidden="true"><svg class="w-40 h-40 text-primary opacity-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg></div><h2 class="text-2xl font-bold mb-2">Self-hosted licences</h2>
            <p class="text-gray-600 mb-10">You run it, on your own infrastructure.</p>
            <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Your servers, your database, your data</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Unlimited emails, contacts, team members and automations</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Three workspaces free, and {capabilityCount} capabilities unlocked by a licence key</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>No account, no phone-home, nothing reported to us</span></li>
            </ul>
            <div class="flex flex-wrap items-center gap-4 mt-auto">
              <a href="/pricing/self-hosted" class="bg-primary text-white px-6 py-2.5 rounded-md font-semibold hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']">See licences</a>
              <p class="text-gray-600 text-sm">Free · or from $290/year</p>
            </div>
          </div>
          <div class="relative overflow-hidden border border-gray-200 rounded-xl p-8 bg-white hover:border-primary transition-colors flex flex-col">
            <div class="absolute -top-8 -right-8 pointer-events-none" aria-hidden="true"><svg class="w-40 h-40 text-primary opacity-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.8 19a4.3 4.3 0 0 1-.6-8.55A6 6 0 0 1 17.9 8.7 4.6 4.6 0 0 1 17.2 19Z"/><path d="m9.5 14.5 2 2 3.5-3.5"/></svg></div><h2 class="text-2xl font-bold mb-2">Notifuse Cloud</h2>
            <p class="text-gray-600 mb-10">We run it. You log in.</p>
            <ul class="space-y-2.5 text-sm text-gray-700 mb-8 flex-1">
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>A dedicated PostgreSQL server, with a separate database per workspace</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Daily backups with point-in-time recovery</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Hosted in the EU, GDPR compliant</span></li>
              <li class="flex gap-2.5"><span class="text-primary shrink-0">✓</span><span>Every capability included, on every plan — nothing to maintain</span></li>
            </ul>
            <div class="flex flex-wrap items-center gap-4 mt-auto">
              <a href="/pricing/cloud" class="bg-primary text-white px-6 py-2.5 rounded-md font-semibold hover:bg-primary/90 transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']">See Cloud plans</a>
              <p class="text-gray-600 text-sm">From $16/month</p>
            </div>
          </div>
          </div>
          <p class="max-w-4xl mx-auto text-sm text-gray-500 text-center mt-8">
            Not sure? Self-hosting is free to try and there is nothing to cancel — and you can
            move between the two in either direction, because the data export is complete and
            the software is the same.
          </p>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
